# ============================================
# momo's melody studio — Server Environment Variables
# Copy file này thành ".env" rồi điền giá trị thật vào.
# KHÔNG commit file ".env" thật lên git.
# ============================================

# ---------- Database ----------
# Connection string MongoDB. Bắt buộc là Replica Set (kể cả cluster 1 node trên
# MongoDB Atlas cũng được, vì code dùng session.withTransaction() khi tạo Order).
# MongoDB standalone (không phải replica set) sẽ KHÔNG chạy được tính năng đặt hàng.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/<db-name>?retryWrites=true&w=majority

# ---------- Auth (JWT) ----------
# Chuỗi bí mật để ký JWT — dùng chuỗi ngẫu nhiên đủ dài (>= 32 ký tự), KHÔNG dùng giá trị mẫu này.
JWT_SECRET=your_super_secret_random_string_here
# Dùng để ký refresh token — PHẢI khác JWT_SECRET (2 secret riêng biệt để
# access token và refresh token không thể giả mạo lẫn nhau).
JWT_REFRESH_SECRET=your_other_super_secret_random_string_here

# ---------- Server ----------
PORT=4000
# development | production — ảnh hưởng việc có trả stack trace lỗi hay không
NODE_ENV=development
# URL public của chính server này (KHÔNG có dấu / ở cuối). Dùng để build
# callbackURL cho Google OAuth (xem config/passport.js). Local thì để
# http://localhost:4000, production thì là domain thật (VD: Render).
SERVER_URL=http://localhost:4000
# (Tuỳ chọn) DSN của Sentry để tự động báo lỗi production — xem config/logger.js
# SENTRY_DSN=

# ---------- Google OAuth 2.0 ----------
# Tạo tại https://console.cloud.google.com/apis/credentials
# Authorized redirect URI phải trỏ về: <SERVER_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ---------- Cloudinary (lưu trữ ảnh sản phẩm, banner, avatar...) ----------
# Lấy tại https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------- Resend (gửi email) ----------
# Lấy tại https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# ---------- URL Frontend (dùng cho CORS + redirect sau khi login Google) ----------
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ---------- Email nhận thông báo liên hệ (Contact form) ----------
ADMIN_EMAIL=admin@example.com
